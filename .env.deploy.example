# Copy to .env.deploy (ignored). Never commit credentials or populated values.
# Required: your expected 12-digit AWS account ID and an alert email.
AWS_ACCOUNT_ID=
AWS_REGION=us-east-1
AWS_PROFILE=default
# Optional absolute SAM executable path if terminals have different PATH settings.
DEPLOY_STACK_NAME=paanipath-ncr
DEPLOY_ALERT_EMAIL=
DEPLOY_MONTHLY_BUDGET_USD=10
# Explicit approval to create/update billable AWS resources and IAM roles.
DEPLOY_APPROVED=false
# 0 means no reserved concurrency; safer for new accounts with low quotas.
DEPLOY_RESERVED_CONCURRENCY=0
DEPLOY_MEMORY_MB=2048
# Required: a real routing provider key (server-side only).
ORS_API_KEY=
ORS_URL=https://api.openrouteservice.org/v2/directions
PHOTON_URL=https://photon.komoot.io/api/
# Blank: generate on first deploy, reuse on updates. Keep stable for sessions.
SESSION_SECRET=
SEED_MODE=true
# true enables explicitly labelled seed refresh controls for a judge demo.
DEMO_MODE=true
# Post-deploy route verification consumes routing-provider quota.
DEPLOY_SMOKE_ROUTE=true
# Prefer profiles/SSO. If using short-lived credentials, leave AWS_PROFILE blank.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
