{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "types": ["node"],
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true, "noImplicitReturns": true,
    "allowImportingTsExtensions": true, "verbatimModuleSyntax": true,
    "skipLibCheck": true, "noEmit": true,
    "paths": {
      "@paanipath/domain": ["./packages/domain/src/index.ts"],
      "@paanipath/routing": ["./packages/routing/src/index.ts"],
      "@paanipath/data": ["./packages/data/src/index.ts"],
      "@paanipath/ui": ["./packages/ui/src/index.ts"]
    }
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "tests/**/*.ts"]
}
